{
  "name": "raco-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "kill:port": "powershell -Command \"$p = netstat -ano | Select-String ':3000 ' | Where-Object { $_ -match 'LISTENING' } | ForEach-Object { ($_ -split '\\s+')[-1] } | Select-Object -First 1; if ($p) { taskkill /PID $p /F } else { Write-Host 'Port 3000 is free' }\"",
    "dev:fresh": "npm run kill:port && pnpm dev"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "antd": "^6.5.0",
    "dayjs": "^1.11.21",
    "formik": "^2.4.9",
    "js-cookie": "^3.0.8",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-image-crop": "^11.1.2",
    "react-toastify": "^11.1.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.6.16",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}