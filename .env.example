# ─────────────────────────────────────────────────────────────────
# raco-frontend — LOCAL DEVELOPMENT
# ⚠️  NEVER COMMIT THIS FILE — it is in .gitignore
# Next.js loads this file automatically in development
# ─────────────────────────────────────────────────────────────────

# ===========================================================
# Backend API
# ===========================================================
# raco-backend running locally
NEXT_PUBLIC_API_URL="your-backend-url"

# ===========================================================
# Stripe (public key — safe to expose to browser)
# ===========================================================
# Get from: https://dashboard.stripe.com/test/apikeys
# Must match the STRIPE_SECRET_KEY in raco-backend/.env
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ===========================================================
# bKash
# ===========================================================
# true = use sandbox, false = use live
NEXT_PUBLIC_BKASH_SANDBOX=true
# bKash redirects back to this path after payment
NEXT_PUBLIC_BKASH_CALLBACK_PATH=/checkout/bkash-callback

# ===========================================================
# App
# ===========================================================
NEXT_PUBLIC_APP_NAME=Raco
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================================
# Auth (server-side only — NOT prefixed with NEXT_PUBLIC_)
# ===========================================================
# Used to sign the session/JWT cookie on the Next.js server side
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_auth_secret
AUTH_URL=http://localhost:3000

# ===========================================================
# Feature flags
# ===========================================================
NEXT_PUBLIC_ENABLE_BKASH=true
NEXT_PUBLIC_ENABLE_STRIPE=true
