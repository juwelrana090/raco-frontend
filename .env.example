# ─────────────────────────────────────────────────────────────────
# raco-frontend — ENVIRONMENT TEMPLATE
# ✅ COMMIT THIS FILE
# Copy to .env.local for local dev, or set in Vercel dashboard for prod
# ─────────────────────────────────────────────────────────────────

# ─── Backend API ──────────────────────────────────────────────────
# Local dev:  http://localhost:3001/api/v1
# Vercel:     your ngrok URL or deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── Stripe ───────────────────────────────────────────────────────
# Test: pk_test_...   |   Live: pk_live_...
# Must match the STRIPE_SECRET_KEY set in raco-backend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── bKash ────────────────────────────────────────────────────────
NEXT_PUBLIC_BKASH_SANDBOX=true
NEXT_PUBLIC_BKASH_CALLBACK_PATH=/checkout/bkash-callback

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Raco
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth (server-side only) ──────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─── Feature flags ────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_BKASH=true
NEXT_PUBLIC_ENABLE_STRIPE=true
